{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi HCA queue job request",
  "type": "object",
  "required": ["schema_version", "job_id", "operator", "plan", "output_dir", "config", "runtime_lock", "submitted_at"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "minLength": 1},
    "operator": {"type": "string", "minLength": 1},
    "plan": {"type": "string", "minLength": 1},
    "output_dir": {"type": "string", "minLength": 1},
    "config": {"type": "object", "required": ["id", "path", "sha256"]},
    "runtime_lock": {"type": "object", "required": ["path", "sha256"]},
    "workers": {"type": "integer", "minimum": 1},
    "retries": {"type": "integer", "minimum": 0},
    "submitted_at": {"type": "string", "minLength": 1}
  }
}
