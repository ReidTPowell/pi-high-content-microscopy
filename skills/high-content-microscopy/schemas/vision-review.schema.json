{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi HCA vision QC review",
  "type": "object",
  "required": ["schema_version", "reviewer", "candidate_reviews"],
  "properties": {
    "schema_version": {"const": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "candidate_reviews": {"type": "array", "minItems": 1},
    "filter_reviews": {"type": "array"}
  }
}
