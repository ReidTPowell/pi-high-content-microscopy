{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "input", "channels", "analysis"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "input": {"type": "object", "required": ["adapter"]},
    "channels": {"type": "object", "minProperties": 1},
    "analysis": {
      "type": "object",
      "required": ["unit_of_analysis"],
      "properties": {
        "unit_of_analysis": {"enum": ["well", "field", "cell"]},
        "preprocessing": {
          "type": "object",
          "properties": {
            "background_subtraction": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "method": {"enum": ["percentile", "opening"]},
                "percentile": {"type": "number", "minimum": 0, "maximum": 100},
                "radius": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "optimization": {
          "type": "object",
          "properties": {
            "mode": {"enum": ["human", "automated"]},
            "max_rounds": {"type": "integer", "minimum": 1},
            "vision_acceptance_score": {"type": "number", "minimum": 0, "maximum": 100},
            "minimum_heldout_wells": {"type": "integer", "minimum": 1},
            "minimum_heldout_fields": {"type": "integer", "minimum": 1}
          }
        },
        "measurements": {
          "oneOf": [
            {"type": "array", "items": {"enum": ["count", "area", "shape", "intensity", "texture"]}},
            {"type": "object", "required": ["metrics", "regions", "channel_roles"], "properties": {
              "metrics": {"type": "array", "items": {"enum": ["count", "area", "shape", "intensity", "texture"]}},
              "regions": {"type": "array", "items": {"enum": ["nucleus", "cell", "cytoplasm"]}},
              "channel_roles": {"type": "array", "items": {"type": "string"}}
            }}
          ]
        },
        "features": {"type": "object"},
        "classification": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "region": {"enum": ["nucleus", "cell", "cytoplasm"]},
            "default": {"type": "string"},
            "rules": {"type": "array", "items": {"type": "object"}}
          }
        },
        "derived_metrics": {"type": "array", "items": {"enum": ["nucleus_to_cytoplasm_ratio"]}},
        "embedding": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "provider": {"const": "openphenom"},
            "adapter_script": {"type": ["string", "null"]},
            "environment": {"type": "string"},
            "model_revision": {"type": ["string", "null"]},
            "channelwise": {"type": "boolean"}
          }
        }
      }
    },
    "controls": {"type": "object"}
  }
}
