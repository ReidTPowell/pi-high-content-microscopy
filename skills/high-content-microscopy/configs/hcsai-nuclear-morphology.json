{
  "name": "HCS.ai nuclear morphology",
  "template": {"id": "nuclear-morphology", "family": "morphology", "description": "Nuclear shape, texture, and intensity phenotypes.", "confirm": ["DNA channel", "expected nuclear size", "condensed and fragmented object policy"]},
  "input": {"adapter": "hcsai", "extensions": [".tif", ".tiff"], "expected_channels": [0], "expected_z_planes": [0]}, "channels": {"0": {"name": "DNA", "role": "nucleus"}},
  "analysis": {"unit_of_analysis": "cell", "preprocessing": {"background_subtraction": {"enabled": true, "method": "percentile", "percentile": 2.0, "radius": 25}}, "qc": {"flag_saturated_pixels": true, "review_focus": true}, "optimization": {"mode": "human", "max_rounds": 3, "vision_acceptance_score": 90, "minimum_heldout_wells": 3, "minimum_heldout_fields": 9},
    "segmentation": {"nucleus": {"enabled": true, "channel_role": "nucleus", "engine": "cellpose", "model": "nuclei", "gpu": true, "cellpose": {"flow_threshold": 0.4, "cellprob_threshold": 0.0, "normalize": true, "tile_overlap": 0.1}, "filter": {"min_area_px": null, "max_area_px": null, "min_intensity_mean": null, "max_intensity_mean": null}}, "cell": {"enabled": false}, "relationship": {"enabled": false}, "overlays": true},
    "measurements": {"metrics": ["count", "area", "shape", "intensity", "texture"], "regions": ["nucleus"], "channel_roles": ["nucleus"]}, "measurement_image": "corrected", "embedding": {"enabled": false, "provider": "openphenom"}, "reporting": {"enabled": true}}
}
