{
  "name": "hcsai-threshold-smoke",
  "input": {"adapter": "hcsai", "extensions": [".tif", ".tiff"], "expected_channels": [0, 1], "expected_z_planes": [0]},
  "channels": {
    "0": {"name": "DAPI", "role": "nucleus"},
    "1": {"name": "TRITC-phalloidin", "role": "cell_boundary"}
  },
  "analysis": {
    "unit_of_analysis": "well",
    "qc": {"flag_saturated_pixels": true, "review_focus": true},
    "segmentation": {
      "nucleus": {"enabled": true, "channel_role": "nucleus", "engine": "threshold"},
      "cell": {"enabled": true, "channel_role": "cell_boundary", "engine": "threshold", "use_nuclear_image": false},
      "relationship": {"enabled": true, "min_overlap": 0.05, "max_orphan_fraction": 1.0, "max_ambiguous_fraction": 1.0},
      "overlays": true
    },
    "measurements": ["count", "area", "intensity"]
  }
}
