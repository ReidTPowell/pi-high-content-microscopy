{
  "name": "HCS.ai puncta per cell",
  "template": {"id": "puncta-per-cell", "family": "spots", "description": "Bright puncta detection assigned to relational cell masks.", "confirm": ["nuclear, boundary, and puncta channels", "expected punctum size", "spot threshold and parent region"]},
  "input": {"adapter": "hcsai", "extensions": [".tif", ".tiff"], "expected_channels": [0, 1, 2], "expected_z_planes": [0]}, "channels": {"0": {"name": "DAPI", "role": "nucleus"}, "1": {"name": "Cell boundary", "role": "cell_boundary"}, "2": {"name": "Puncta", "role": "puncta"}},
  "analysis": {"unit_of_analysis": "cell", "preprocessing": {"background_subtraction": {"enabled": true, "method": "percentile", "percentile": 5.0, "radius": 25}}, "qc": {"flag_saturated_pixels": true, "review_focus": true}, "optimization": {"mode": "human", "max_rounds": 3, "vision_acceptance_score": 90, "minimum_heldout_wells": 3, "minimum_heldout_fields": 9},
    "segmentation": {"nucleus": {"enabled": true, "channel_role": "nucleus", "engine": "cellpose", "model": "nuclei", "gpu": true, "cellpose": {"flow_threshold": 0.4, "cellprob_threshold": 0.0}, "filter": {}}, "cell": {"enabled": true, "channel_role": "cell_boundary", "engine": "cellpose", "model": "cyto3", "use_nuclear_image": true, "gpu": true, "cellpose": {"flow_threshold": 0.4, "cellprob_threshold": 0.0}, "filter": {}}, "relationship": {"enabled": true, "min_overlap": 0.5, "max_orphan_fraction": 0.1, "max_ambiguous_fraction": 0.05}, "overlays": true},
    "measurements": {"metrics": ["count", "area", "intensity"], "regions": ["nucleus", "cell", "cytoplasm"], "channel_roles": ["puncta"]}, "features": {"puncta": [{"enabled": true, "name": "puncta", "channel_role": "puncta", "parent_region": "cell", "sigma": 1.0, "background_sigma": 4.0, "threshold_percentile": 99.5, "min_area_px": 2, "max_area_px": null}]}, "measurement_image": "corrected", "embedding": {"enabled": false, "provider": "openphenom"}, "reporting": {"enabled": true}}
}
