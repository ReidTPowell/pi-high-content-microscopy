{
  "name": "HCS.ai cell-only morphology",
  "template": {"id": "cell-morphology", "family": "morphology", "description": "Whole-cell masks and morphology without requiring nuclear output.", "confirm": ["cell-boundary channel", "whether a nuclear guidance channel exists", "expected cell size and contact"]},
  "input": {"adapter": "hcsai", "extensions": [".tif", ".tiff"], "expected_channels": [0], "expected_z_planes": [0]},
  "channels": {"0": {"name": "Cell boundary", "role": "cell_boundary"}},
  "analysis": {
    "unit_of_analysis": "cell", "preprocessing": {"background_subtraction": {"enabled": false, "method": "percentile", "percentile": 5.0, "radius": 25}},
    "qc": {"flag_saturated_pixels": true, "review_focus": true}, "optimization": {"mode": "human", "max_rounds": 3, "vision_acceptance_score": 90, "minimum_heldout_wells": 3, "minimum_heldout_fields": 9},
    "segmentation": {"nucleus": {"enabled": false}, "cell": {"enabled": true, "channel_role": "cell_boundary", "engine": "cellpose", "model": "cyto3", "use_nuclear_image": false, "gpu": true, "cellpose": {"flow_threshold": 0.4, "cellprob_threshold": 0.0, "normalize": true, "tile_overlap": 0.1}, "filter": {"min_area_px": null, "max_area_px": null, "min_intensity_mean": null, "max_intensity_mean": null}}, "relationship": {"enabled": false}, "overlays": true},
    "measurements": {"metrics": ["count", "area", "shape"], "regions": ["cell"], "channel_roles": []}, "measurement_image": "raw", "embedding": {"enabled": false, "provider": "openphenom"}, "reporting": {"enabled": true}
  }
}
