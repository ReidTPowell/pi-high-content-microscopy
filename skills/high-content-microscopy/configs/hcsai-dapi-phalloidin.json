{
  "name": "hcsai-dapi-phalloidin-example",
  "input": {
    "adapter": "hcsai",
    "extensions": [".tif", ".tiff"],
    "expected_channels": [0, 1],
    "expected_z_planes": [0]
  },
  "channels": {
    "0": {"name": "DAPI", "role": "nucleus"},
    "1": {"name": "TRITC-phalloidin", "role": "cell_boundary"}
  },
  "analysis": {
    "unit_of_analysis": "well",
    "qc": {"flag_saturated_pixels": true, "review_focus": true},
    "segmentation": {
      "nucleus": {"enabled": true, "channel_role": "nucleus", "engine": "cellpose", "model": "nuclei"},
      "cell": {"enabled": true, "channel_role": "cell_boundary", "engine": "cellpose", "model": "cyto3", "use_nuclear_image": true},
      "relationship": {"enabled": true, "min_overlap": 0.5, "max_orphan_fraction": 0.1, "max_ambiguous_fraction": 0.05},
      "overlays": true
    },
    "measurements": ["count", "area", "shape", "intensity"]
  }
}
