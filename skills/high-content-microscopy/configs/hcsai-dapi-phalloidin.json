{
  "name": "hcsai-dapi-phalloidin-example",
  "input": {
    "adapter": "hcsai",
    "extensions": [".tif", ".tiff"],
    "expected_channels": [0, 1],
    "expected_z_planes": [0]
  },
  "channels": {
    "0": {"name": "DAPI", "role": "nucleus"},
    "1": {"name": "TRITC-phalloidin", "role": "cell_boundary"}
  },
  "analysis": {
    "unit_of_analysis": "well",
    "preprocessing": {
      "background_subtraction": {"enabled": false, "method": "percentile", "percentile": 5.0, "radius": 25}
    },
    "qc": {"flag_saturated_pixels": true, "review_focus": true},
    "optimization": {"mode": "human", "max_rounds": 3, "vision_acceptance_score": 90,
      "minimum_heldout_wells": 3, "minimum_heldout_fields": 9},
    "segmentation": {
      "nucleus": {"enabled": true, "channel_role": "nucleus", "engine": "cellpose", "model": "nuclei", "gpu": true,
        "cellpose": {"flow_threshold": 0.4, "cellprob_threshold": 0.0, "normalize": true, "tile_overlap": 0.1},
        "filter": {"min_area_px": null, "max_area_px": null, "min_intensity_mean": null, "max_intensity_mean": null}},
      "cell": {"enabled": true, "channel_role": "cell_boundary", "engine": "cellpose", "model": "cyto3", "use_nuclear_image": true, "gpu": true,
        "cellpose": {"flow_threshold": 0.4, "cellprob_threshold": 0.0, "normalize": true, "tile_overlap": 0.1},
        "filter": {"min_area_px": null, "max_area_px": null, "min_intensity_mean": null, "max_intensity_mean": null}},
      "relationship": {"enabled": true, "min_overlap": 0.5, "max_orphan_fraction": 0.1, "max_ambiguous_fraction": 0.05},
      "overlays": true
    },
    "measurements": ["count", "area", "shape", "intensity"],
    "measurement_image": "corrected",
    "embedding": {"enabled": false, "provider": "openphenom", "adapter_script": "bundled",
                  "environment": "openphenom", "model_revision": null, "channelwise": false},
    "reporting": {"enabled": true}
  }
}
